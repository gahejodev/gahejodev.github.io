rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function parentCoursePublished(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.published == true;
    }

    match /profiles/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly(['uid','email','displayName','role','createdAt','updatedAt']);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt','lastLoginAt']);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','description','published','createdAt','updatedAt','createdBy']);
      allow update, delete: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if isAdmin() || (parentCoursePublished(courseId) && resource.data.published == true);
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['title','description','order','published','createdAt','updatedAt','createdBy']);
        allow update, delete: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if isAdmin() || (parentCoursePublished(courseId)
            && get(/databases/$(database)/documents/courses/$(courseId)/chapters/$(chapterId)).data.published == true
            && resource.data.published == true);
          allow create: if isAdmin()
            && request.resource.data.keys().hasOnly(['title','type','content','order','published','createdAt','updatedAt','createdBy'])
            && request.resource.data.type in ['text','video','pdf'];
          allow update, delete: if isAdmin();
        }
      }
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','message','published','createdAt','updatedAt','createdBy']);
      allow update, delete: if isAdmin();
    }

    match /courses/{courseId}/chapters/{chapterId}/questions/{questionId} {
      allow read: if isAdmin() || (parentCoursePublished(courseId)
        && get(/databases/$(database)/documents/courses/$(courseId)/chapters/$(chapterId)).data.published == true
        && resource.data.published == true);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['question','options','correctOption','explanation','order','published','createdAt','updatedAt','createdBy'])
        && request.resource.data.correctOption in ['A','B','C','D']
        && request.resource.data.options.keys().hasOnly(['A','B','C','D']);
      allow update, delete: if isAdmin();
    }

    match /students/{uid}/quizAttempts/{attemptId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','courseId','chapterId','courseTitle','chapterTitle','totalQuestions','correctAnswers','score','percentage','answers','createdAt'])
        && request.resource.data.totalQuestions is int
        && request.resource.data.correctAnswers is int
        && request.resource.data.score is int
        && request.resource.data.percentage is number
        && request.resource.data.answers is map;
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /students/{uid}/progress/{progressId} {
      allow read, create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}